# ==============================================================================
# CLIENT ORCHESTRATOR SVC — Configuration
# ==============================================================================

APP_ENV=development
APP_DEBUG=true
APP_PORT=8004
APP_HOST=0.0.0.0

# Database Configuration
DATABASE_URL=sqlite:///./data/orchestrator.db

# Connected Platform Services
FINDER_SVC_URL=http://localhost:8000
MESSAGER_SVC_URL=http://localhost:8001
INTELLIGENCE_SVC_URL=http://localhost:8002
CORE_SVC_URL=http://localhost:8003

# Pipeline Automation Rules
PIPELINE_MIN_QUALIFICATION_SCORE=75.0
PIPELINE_SYNC_INTERVAL_MINUTES=15
